{
  "manifest_version": 3,
  "name": "Hide Chat History",
  "version": "0.1.0",
  "description": "Hides chat titles in AI chat sidebars. Hover a row to reveal it.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Hide Chat History",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "css": ["sites/claude.css"],
      "js": ["shared/sites.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
